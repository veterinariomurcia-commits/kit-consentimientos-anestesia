{
  "name": "kit-consentimientos-anestesia",
  "version": "1.0.0",
  "description": "Herramienta web gratuita para generar, con los datos de cada clínica, el consentimiento y la información de anestesia en Word.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "muestras": "node scripts/muestras.ts",
    "logo-ejemplo": "node scripts/crear-logo-ejemplo.ts",
    "contenido": "node scripts/ver-contenido.ts"
  },
  "dependencies": {
    "docx": "9.16.1",
    "jszip": "3.10.2",
    "pdfmake": "0.3.14"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@types/pdfmake": "0.3.3",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  }
}
